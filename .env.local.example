# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

# Email de la cuenta de servicio. Está en el JSON descargado, campo "client_email".
# Ejemplo: leads-writer@mi-proyecto.iam.gserviceaccount.com
GOOGLE_SHEETS_CLIENT_EMAIL=

# Clave privada de la cuenta de servicio. Está en el JSON, campo "private_key".
# IMPORTANTE: en .env debe ir en UNA sola línea, con los saltos de línea
# escapados como \n y todo entre comillas dobles. El código hace
# .replace(/\\n/g, '\n') al leerla. Ejemplo:
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PRIVATE_KEY=

# ID de la Google Sheet (está en la URL de la hoja, entre /d/ y /edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Rango donde se hace el append. La pestaña debe llamarse igual (aquí "Leads").
# Ahora son 10 columnas (A:J): la J es "Distrito" (opcional, del popup promocional).
# Si ya tenías A:I, añade el encabezado "Distrito" en la columna J y cambia esto a A:J.
GOOGLE_SHEETS_RANGE=Leads!A:J

# Origen permitido para CORS.
# "*" permite cualquier origen (cómodo para pruebas).
# EN PRODUCCIÓN restríngelo a tu dominio, p. ej.:
# ALLOWED_ORIGIN=https://landing.comunik2.pe
ALLOWED_ORIGIN=*
